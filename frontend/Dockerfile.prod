# ------------------------------------------------------------------
# Production image — multi-stage build.
#
# Stage 1 installs deps and runs the Vite production build. Stage 2 is
# just Nginx serving the static output — no Node.js, no source code,
# no node_modules ship in the final image.
# ------------------------------------------------------------------

# --- Stage 1: build ---
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# VITE_API_BASE_URL must be provided at BUILD time (Vite inlines env vars
# into the static bundle at build, unlike server-rendered apps where it
# could be read at runtime) — passed via --build-arg in docker-compose.prod.yml / Render.
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

# --- Stage 2: serve ---
FROM nginx:1.27-alpine AS runtime

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
